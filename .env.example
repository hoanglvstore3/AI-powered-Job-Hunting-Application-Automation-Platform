# Copy sang .env.local — KHÔNG commit file .env.local, KHÔNG ghi secret vào code (§13)
# Google OAuth cho đăng nhập website (NextAuth, Google provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Chỉ những email này được đăng nhập (chủ sở hữu). Mặc định: hoanglv00256@gmail.com
OWNER_EMAILS=hoanglv00256@gmail.com
# Google Sheet "Job Hunting — Data" (Giai đoạn 1, §6). Chưa có thì để trống — app chạy chế độ dữ liệu mẫu có ghi rõ.
GOOGLE_SHEET_ID=
# Service account đọc Sheet (server-side only). Dán toàn bộ JSON vào 1 dòng, hoặc trỏ file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Ngưỡng matching mặc định (FR-06). Doc không ghi con số — giả định 60, chờ Shu chốt.
MATCH_THRESHOLD=60
